#!/usr/bin/env python3
"""UX review fixes, in-game UI (lane uxgame, research/ux_review_2026-10-13.md items 2-30): one leased pair, hidden
windows 1512x982, mp.json session (host the owner, guest Ben), base save MoonlightBrigade. Frames: research/ux_shots/fix_*.png.
  uxgame_pair.py --repro [--dylib PATH]   item 6 before the fix: Esc menus open at the expedition start -> still
                                          paused on 1F (expected to FAIL the "not paused" check with the old build)
  uxgame_pair.py [--dylib PATH]           every fixed item, checks + frames
Each step is independent: a failure is logged and the run goes on. Leases a free pair (lane "uxgame")."""
import json, os, re, shutil, sys, time, traceback
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.expanduser('~/ds_multiplayer/research/ux_shots'))
import ux                                                     # start (hidden window, resolution) / shot (backbuffer)
import subprocess
rig = ux.rig


def start(x, W, H):
    """ux.start plus DSRIG_BG=1 (nice 19 + background priority: the owner plays on this Mac, lead 2026-10-13)"""
    rig.prepare_data(x); rig.fix_mp_port(x)
    us = os.path.join(rig.idir(x), 'data', 'UserSetting.json'); d = json.load(open(us)); g = d['GraphicSettingData']
    for a, b in (('ResolutionWidth', 'ResolutionHeight'), ('WindowedResolutionWidth', 'WindowedResolutionHeight'), ('FullScreenResolutionWidth', 'FullScreenResolutionHeight')):
        g[a], g[b] = W, H
    json.dump(d, open(us, 'w'), indent=1)
    for k, v in (('Screenmanager Resolution Width', W), ('Screenmanager Resolution Height', H)):
        subprocess.run(['defaults', 'write', f'com.CanOpener.Dungeon-Settlers.mp{x}', k, '-int', str(v)])
    if os.path.exists(rig.sockpath(x)): os.unlink(rig.sockpath(x))
    env = {'HOME': os.path.join(rig.idir(x), 'home'), 'CFFIXED_USER_HOME': os.path.join(rig.idir(x), 'home'),
           'USER': os.environ.get('USER', ''), 'LOGNAME': os.environ.get('LOGNAME', ''), 'PATH': '/usr/bin:/bin:/usr/sbin:/sbin',
           'TMPDIR': os.environ.get('TMPDIR', '/tmp'), 'DSRIG_DIR': rig.idir(x), 'DSRIG_FPS': '30',
           'DYLD_INSERT_LIBRARIES': rig.DYLIB, 'DSRIG_HIDEWIN': '1'}
    args = [os.path.join(rig.idir(x), rig.EXE_REL), '-logFile', os.path.join(rig.idir(x), 'player.log'), '-screen-fullscreen', '0',
            '-screen-width', str(W), '-screen-height', str(H)]
    open(os.path.join(rig.idir(x), 'launch.json'), 'w').write(json.dumps({'args': args, 'env': env, 'front_before': rig.front_pid() or 0, 'bg': BG, 'show': False}))
    open(rig.pidfile(x), 'w').write('')
    subprocess.Popen([sys.executable, os.path.join(rig.ROOT, 'rig', 'rig.py'), '_guard', x], stdin=subprocess.DEVNULL,
                     stdout=open(os.path.join(rig.idir(x), 'guard.log'), 'ab'), stderr=subprocess.STDOUT, start_new_session=True)
    for _ in range(100):
        if rig.alive(rig.read_pid(x)): break
        time.sleep(0.1)
    print(x, 'started pid', rig.read_pid(x), W, H, flush=True)
# nice 19 + background priority in the guard (lead rule); never run this driver itself under `nice`: the guard's
# os.nice() in the child then fails with EPERM and the copy never starts. UX_BG=0: nice 5 (old behaviour).
BG = os.environ.get('UX_BG', '1') == '1'
SHOTS = os.path.expanduser('~/ds_multiplayer/research/ux_shots')
SAVE = os.path.join(rig.SEED_DATA, 'Saves', 'MoonlightBrigade__AutoSave_41e9c1bb8790492cbdc10f4dcad22179_0.json')
results = {}


def arg(name, default):
    a = sys.argv
    return type(default)(a[a.index(name) + 1]) if name in a else default


def log(*a):
    print(time.strftime('%H:%M:%S'), *a, flush=True)


def check(name, ok, info=''):
    results[name] = bool(ok)
    log(('PASS ' if ok else 'FAIL ') + name, str(info)[:600])


def c(x, **k):
    try:
        return rig.send(x, k, timeout=120)
    except Exception as e:
        return {'ok': False, 'error': repr(e)}


def st(x):
    return c(x, cmd='status')


def view(x):
    return c(x, cmd='ui_view')


def wait(what, pred, timeout=600, every=2):
    t0 = time.time()
    while time.time() - t0 < timeout:
        try:
            r = pred()
        except Exception:
            r = None
        if r:
            return r
        time.sleep(every)
    raise RuntimeError('timeout: ' + what)


def step(name, fn):
    only = os.environ.get('UXONLY')
    if only and name not in only.split(','):
        return
    log('--- step', name)
    try:
        fn()
    except Exception:
        check('step ' + name + ' ran', False, traceback.format_exc()[-700:])


def shot(x, name):
    p = os.path.join(SHOTS, f'{name}.png' if name.startswith('v2_') else f'fix_{name}.png')
    r = c(x, cmd='mpm_shot', how='backbuffer', path=p)
    log('frame', p, r.get('ok'))
    return p


def inject(x, ev, **f):
    d = {'cmd': 'ord_inject', 'ev': ev}
    d.update({k.replace('_', '@'): v for k, v in f.items()})
    return c(x, **d)


def tm(x, **k):
    return c(x, cmd='ui_teams', **k)


def units(x, m=None):
    k = {'cmd': 'list_units'}
    if m is not None:
        k['map'] = m
    return [u for u in c(x, **k).get('units', []) if u['faction'] == 1 and not u['dead']]


def log_since(x, mark):
    with open(os.path.join(rig.idir(x), 'rig.log'), errors='replace') as f:
        f.seek(mark)
        return f.read()


def mark(x):
    return os.path.getsize(os.path.join(rig.idir(x), 'rig.log'))


def ticking(xs, secs=6):
    a = [st(x).get('tick', -1) for x in xs]; time.sleep(secs); b = [st(x).get('tick', -1) for x in xs]
    return all(bb > aa >= 0 for aa, bb in zip(a, b)), (a, b)


def move_order(x, g, cell):
    """the normal input path: select the unit, right-click a cell"""
    c(x, cmd='ord_hover', n=0); inject(x, 'SelectPlayerUnitRequested', i32_16=0, guid_20=g)
    inject(x, 'InteractGridRequested', v2_16=f'{cell[0]},{cell[1]}', u8_24=0)


def tipchk(x, title, frame):
    """lan_v9 item 1: hover our element with this title (test hover, no mouse); the game's tooltip window shows it"""
    # pair AB 04:45: visible tooltips were seen 1.2-1.5 s after the hover, never in frames at 0.3-0.8 s; some shows stay
    # invisible while ui_tip says shown (ui_tip.c, reported to menuteams). Hide first, wait 1.5 s, then the frame.
    c(x, cmd='ui_tip', action='hide'); time.sleep(0.5)
    c(x, cmd='ui_tip_hover', title=title); time.sleep(1.5); r = c(x, cmd='ui_tip_hover', title=title)
    check(f'v9 tooltip "{title}" in the game\'s tooltip window', r.get('ready') == 1 and r.get('shown') == title, r)
    shot(x, frame)
    c(x, cmd='ui_tip_hover', title=''); c(x, cmd='ui_tip', action='hide')
    return r


def fp_equal_from_xy(X, Y, t_from):
    def rd(i):
        d = {}
        for line in open(os.path.join(rig.idir(i), 'fp.log')):
            p = line.split()
            if len(p) >= 2 and p[0].isdigit() and int(p[0]) >= t_from:
                d[int(p[0])] = p[1]
        return d
    a, b = rd(X), rd(Y)
    com = sorted(set(a) & set(b))
    return len(com), next((t for t in com if a[t] != b[t]), None)


def main():
    rig.DYLIB = arg('--dylib', os.path.expanduser('~/ds_multiplayer/build/uxgame/dsrig.dylib'))
    t0 = time.time()                                          # only AB / CD / EF are usable (lead 2026-10-13): wait for one
    while True:
        def take(d):                                          # the first of AB / CD / EF that is free AND has no copy running
            rig._free_stale(d)
            if len(d) >= int(os.environ.get('DSRIG_MAX_PAIRS', '3')): return None
            for pr in ('AB', 'CD', 'EF'):
                if pr not in d and not any(rig.alive(rig.read_pid(i)) for i in pr):
                    d[pr] = {'lane': 'uxgame', 'pid': os.getpid(), 'since': time.time(), 'used': time.time()}; return pr
            return None
        pair = rig._with_leases(take)
        if pair:
            break
        if time.time() - t0 > 4 * 3600:
            raise SystemExit('no free pair (AB/CD/EF) in 4 h')
        time.sleep(30)
    X, Y = pair[0], pair[1]
    ux.LEASED = pair
    for i in (X, Y):
        if rig.alive(rig.read_pid(i)):
            rig.release(pair)
            raise SystemExit(f'{i} is still running: not mine, pair released')
    log('pair', pair, 'dylib', rig.DYLIB)
    try:
        run(X, Y, rig.PAIR_PORTS[pair])
        if os.environ.get('UX_KEEP'):                         # debugging: keep the pair up until this file exists (max 2 h)
            stopf = os.environ['UX_KEEP']; log('keeping', pair, 'until', stopf, 'exists')
            t_k = time.time()
            while not os.path.exists(stopf) and time.time() - t_k < 7200:
                time.sleep(5)
    finally:
        for i in (X, Y):
            try:
                rig.stop(i)
            except Exception as e:
                log('stop', i, e)
        rig.release(pair)
        log('check-prefs', 'identical' if rig.check_prefs() else 'DIFFERENT')
        ok = results and all(results.values())
        log('RESULT', 'PASS' if ok else 'FAIL', json.dumps(results))


def run(X, Y, PORT):
    assert rig.check_prefs(), 'owner prefs differ before start'
    json.dump({'role': 'host', 'port': PORT, 'name': 'The owner', 'allow_speedup': True, 'allow_pause': True},
              open(os.path.join(rig.idir(X), 'mp.json'), 'w'))
    json.dump({'role': 'client', 'host': '127.0.0.1', 'port': PORT, 'name': 'Ben'},
              open(os.path.join(rig.idir(Y), 'mp.json'), 'w'))
    for i in (X, Y):                                          # owners saved by earlier runs: start clean (moved aside)
        d = os.path.join(rig.idir(i), 'data', 'mp_owners')
        if os.path.isdir(d):
            os.rename(d, d + time.strftime('.prev_%Y%m%d_%H%M%S'))
        os.makedirs(os.path.join(rig.idir(i), 'data'), exist_ok=True)
        open(os.path.join(rig.idir(i), 'data', 'mp_ui.json'), 'w').write('{"see_through":0,"names":1,"list_open":0}\n')
        for nm in ('mp_teams_button.json', 'mp_ui_viewer.json'):   # Teams button / viewer box start at their default place
            tb = os.path.join(rig.idir(i), 'data', nm)
            if os.path.exists(tb):
                os.rename(tb, tb + time.strftime('.prev_%Y%m%d_%H%M%S'))
    run_mark = {}
    start(X, 1512, 982)
    wait('title host', lambda: (lambda s: s.get('scene') == 1 and not s.get('busy'))(st(X)), timeout=1500, every=5)
    run_mark[X] = mark(X)
    work = os.path.join(rig.idir(X), 'save_in'); os.makedirs(work, exist_ok=True)
    src = os.path.join(work, os.path.basename(SAVE)); shutil.copy2(SAVE, src)
    log('host load', c(X, cmd='load_save', file=src, det=1))
    wait('host locked', lambda: st(X).get('det', {}).get('locked'), timeout=900, every=3)
    # host alone (the 15:45 crash: the panel frame's tint hit a Transform, SIGSEGV about 1 s after load)
    time.sleep(15)
    c(X, cmd='ui_click', row=0); time.sleep(3)
    va = view(X)
    check('host alone: alive 15 s after load, panel framed and open', rig.alive(rig.read_pid(X)) and va.get('ok') and va.get('band') == 1 and va.get('plate', {}).get('active') == 1, f"alive {rig.alive(rig.read_pid(X))} band {va.get('band')} plate {va.get('plate')}")
    shot(X, 'v2_panel_host_alone')
    c(X, cmd='ui_click', row=0); time.sleep(1)
    start(Y, 1512, 982)
    try:
        wait('title guest', lambda: (lambda s: s.get('scene') == 1 and not s.get('busy'))(st(Y)), timeout=1500, every=5)
    except RuntimeError:
        log('guest guard.log:', open(os.path.join(rig.idir(Y), 'guard.log'), errors='replace').read()[-800:])
        log('guest status:', st(Y))
        raise
    run_mark[Y] = mark(Y)
    wait('guest loaded', lambda: (lambda s: s.get('det', {}).get('locked') and s.get('mp', {}).get('loads', 0) >= 1)(st(Y)), timeout=900, every=3)
    time.sleep(8)
    S = {}
    fp_equal_from = lambda t: fp_equal_from_xy(X, Y, t)

    def teams():                                              # guest takes 2 + marks 1 + ready; host takes 2 + marks 2
        tm(X, action='open'); tm(Y, action='open'); time.sleep(3)
        allu = [u['guid'] for u in units(X, 0)]
        g, h = allu[:2], allu[2:4]
        for u in g: tm(Y, action='click', guid=u, button=0); time.sleep(1)
        for u in h: tm(X, action='click', guid=u, button=0); time.sleep(1)
        time.sleep(3)
        tm(Y, action='click', guid=g[0], button=1)
        for u in h: tm(X, action='click', guid=u, button=1)
        time.sleep(2)
        time.sleep(1)                                       # (no Ready here: it proposes an expedition now)
        tm(X, action='close'); tm(Y, action='close'); time.sleep(2)
        S['g'], S['h'] = g, h
    step('teams', teams)

    def expedition(tag):                                       # teams lane 2026-10-13: proposal flow (go -> stock accept -> approve)
        for x in (X, Y):
            if view(x).get('esc_open'): inject(x, 'ToggleSystemMenuRequested'); time.sleep(1)
        tm(X, action='open'); time.sleep(1)
        tm(X, action='go')                                     # teamsfinish 2026-10-14: no marks / Go; the stock window opens at step 1
        wait('stock step 1', lambda: (lambda t: t.get('stock', {}).get('open') and t['stock'].get('state') == 0)(tm(X)), timeout=60, every=2)
        tm(X, action='stock_select', units=','.join(S['h'][:2] + S['g'][:2])); time.sleep(1)   # host's + Ben's units (cap 4)
        tm(X, action='stock_next')
        wait('proposer stock step', lambda: tm(X)['stock'].get('state') == 1, timeout=60, every=2)
        tm(X, action='stock_accept')
        # the receiver packs in the stock window only when the proposal has units of his; else he gets the summary
        wait('receiver step', lambda: (lambda t: (t.get('stock', {}).get('open') and t['stock'].get('mode') == 2) or t.get('prop', {}).get('shown'))(tm(Y)), timeout=90, every=2)
        if tm(Y).get('stock', {}).get('open'):
            tm(Y, action='stock_next')
            wait('receiver summary', lambda: tm(Y).get('prop', {}).get('shown'), timeout=60, every=2)
        tm(Y, action='approve')
        wait('both in the dungeon', lambda: (lambda a, b: a.get('map', 0) != 0 and b.get('map', 0) != 0 and a.get('det', {}).get('locked')
                                             and b.get('det', {}).get('locked') and not a.get('busy') and not b.get('busy'))(st(X), st(Y)), timeout=400, every=3)
        time.sleep(8)

    if '--repro' in sys.argv:                                 # item 6 with the build under test (old one: expected FAIL)
        def repro():
            c(X, cmd='mpm_esc'); c(Y, cmd='mpm_esc'); time.sleep(3)
            va, vb = view(X), view(Y)
            log('Esc open: host status', va.get('status'), '| guest status', vb.get('status'))
            expedition('repro')
            ok, info = ticking((X, Y))
            va, vb = view(X), view(Y)
            check('item 6 repro: on 1F after Esc-at-start, both run (no stuck pause)', ok and 'Paused' not in va.get('status', '') and 'Paused' not in vb.get('status', ''),
                  f"ticks {info} host '{va.get('status')}' guest '{vb.get('status')}'")
            shot(X, '06_repro_1F_host')
        step('repro', repro)
        return

    # ---- items 2, 3, 23: panel plate, readable at the top, settings look clickable
    def panel():
        va = view(X)
        check('v2 §3 framed panel, 300 wide, header with cog', va.get('plate', {}).get('active') == 1 and va['plate']['w'] == 300 and va.get('gear') == 1, f"{va.get('plate')} gear {va.get('gear')}")
        shot(X, 'v2_panel_collapsed_host')
        c(X, cmd='ui_click', row=0); c(Y, cmd='ui_click', row=0); time.sleep(2)
        va, vb = view(X), view(Y)
        check('v2 §3 panel opens (rows)', va['plate']['active'] == 1 and va['plate']['h'] > 60, va.get('plate'))
        check('v2 §1 connection bars: 3 on the other player row, none on your own (both peers)', va.get('bars_on') == 3 and vb.get('bars_on') == 3, f"{va.get('bars_on')} {vb.get('bars_on')}")
        check('v2 §1 no milliseconds in the rows', ' ms' not in va['panel'][1]['text'] + va['panel'][7]['text'], va['panel'][7]['text'])
        c(X, cmd='ui_pop', open=1); time.sleep(1.5)
        va = view(X)
        check('v2 §3 cog opens the settings box (labels muted)', va.get('pop') == 1 and va['panel'][2]['active'] == 1 and '#a69085' in va['panel'][2]['text'], f"pop {va.get('pop')} {va['panel'][2]}")
        shot(X, 'v2_panel_settings_host')
        c(X, cmd='ui_pop', open=0); time.sleep(1)
        check('header band + toggle (no [+]/[-], no glyph)', va.get('band') == 1 and va.get('arrow') == 1 and '[' not in va['panel'][0]['text'], f"band {va.get('band')} arrow {va.get('arrow')} {va['panel'][0]['text']}")
        check('design #13 no [name] tag on portraits', va.get('bar_names') and not any('[' in n for n in va['bar_names']), va.get('bar_names'))
        check('#3 panel position unchanged (top area)', va.get('panel_pos', [0, 0])[1] < 0, va.get('panel_pos'))
        shot(X, 'v2_panel_open_host'); shot(Y, 'v2_panel_open_guest')
        mats = [l for l in log_since(X, run_mark.get(X, 0)).splitlines() if 'plain text material in use' in l]
        check('final: our texts use the font\'s plain material (no outline preset)', mats and not any('utline' in l or 'nderlay' in l for l in mats), mats[-3:] if mats else 'no log line')
    step('panel', panel)

    def units_rule():                                          # uxmenu 2026-10-13: host rule "Units per player"
        c(X, cmd='ui_units', dir=-1); time.sleep(3)
        check('units rule 3 -> 2 on both peers (host settings box)', view(X).get('units_rule') == 2 and view(Y).get('units_rule') == 2, f"{view(X).get('units_rule')} {view(Y).get('units_rule')}")
        free = [u['guid'] for u in units(Y, 0) if c(Y, cmd='ui_owner', guid=u['guid']).get('owner') == -1]
        my = mark(Y)
        if free:
            log('guest claims a 3rd unit', c(Y, cmd='mp_claim', guid=free[0])); time.sleep(3)
            check('refused claim: guest toast "You can control at most 2 units (host rule)"', 'You can control at most 2 units (host rule)' in log_since(Y, my), [l for l in log_since(Y, my).splitlines() if 'units' in l][:3])
        c(X, cmd='ui_pop', open=1); time.sleep(1); shot(X, 'v2_panel_settings_units_host'); c(X, cmd='ui_pop', open=0)
        c(X, cmd='ui_units', dir=1); time.sleep(3)
        check('units rule back to 3', view(X).get('units_rule') == 3 and view(Y).get('units_rule') == 3)
    step('units rule', units_rule)

    def lend():                                                # owner-approved board "Lend control"
        u = S['h'][0]
        r = c(X, cmd='ui_lend', guid=u, action='menu'); time.sleep(1.5)
        check('lend menu on your own portrait: "Lend control to Ben" + "Release (free unit)"', r.get('menu_rows', 0) >= 2 and any('Lend control to Ben' in m for m in r.get('menu', [])) and any('Release' in m for m in r.get('menu', [])), r.get('menu'))
        shot(X, 'v2_lend_menu_host')
        tipchk(X, 'Lend Control to Ben', 'v2_v9_tip_lend_host')
        mx, my = mark(X), mark(Y)
        c(X, cmd='ui_lend', action='row', row=0); time.sleep(4)
        ra, rb = c(X, cmd='ui_lend', guid=u, action='state'), c(Y, cmd='ui_lend', guid=u, action='state')
        check('lent: controller Ben on both peers', ra.get('controller') == 1 and rb.get('controller') == 1, f"{ra.get('controller')} {rb.get('controller')}")
        check('lent: "Lent to Ben" on the owner, "From the owner" on the borrower', any('Lent to Ben' in re.sub('<[^>]+>', '', t) for t in ra.get('labels', [])) and any('From the owner' in re.sub('<[^>]+>', '', t) for t in rb.get('labels', [])), f"{ra.get('labels')} {rb.get('labels')}")
        check('lent: messages "The owner lent you ..." (Ben) / "You lent ... to Ben" (The owner)', 'The owner lent you' in log_since(Y, my) and 'to Ben' in log_since(X, mx))
        shot(X, 'v2_lend_lent_host'); shot(Y, 'v2_lend_lent_guest')
        cell = [x for x in units(Y, 0) if x['guid'] == u][0]['cell']
        def ords(x): m = st(x).get('mp', {}); return m.get('orders', 0), m.get('orders_dropped_owner', 0)
        o1 = ords(X); rig.send(Y, {'cmd': 'mp_move', 'guid': u, 'x': cell[0] + 1, 'y': cell[1]}, timeout=60); time.sleep(4); o2 = ords(X)
        check('lent: the borrower\'s order is applied', o2[0] == o1[0] + 1 and o2[1] == o1[1], f'{o1}->{o2}')
        o1 = ords(Y); rig.send(X, {'cmd': 'mp_move', 'guid': u, 'x': cell[0], 'y': cell[1]}, timeout=60); time.sleep(4); o2 = ords(Y)
        check('lent: the owner\'s own order is dropped while lent', o2[1] == o1[1] + 1, f'{o1}->{o2}')
        my = mark(Y)
        c(X, cmd='ui_lend', guid=u, action='take'); time.sleep(4)
        check('take back: controller cleared on both, "The owner took back ..." for Ben', c(X, cmd='ui_lend', guid=u, action='state').get('controller') == -1 and c(Y, cmd='ui_lend', guid=u, action='state').get('controller') == -1 and 'The owner took back' in log_since(Y, my))
        c(X, cmd='ui_lend', guid=u, action='lend', to=1); time.sleep(4)
        mx = mark(X)
        c(Y, cmd='ui_lend', guid=u, action='give'); time.sleep(4)
        check('give back: controller cleared, "Ben gave back ..." for the owner', c(X, cmd='ui_lend', guid=u, action='state').get('controller') == -1 and 'Ben gave back' in log_since(X, mx))
        shot(X, 'v2_lend_given_back_host')
    step('lend', lend)

    def escape():                                              # owner after lan_v8: Escape closes our boxes first
        def esc(x):
            mk = mark(x); inject(x, 'EscapeActionRequested', u8_16=1); time.sleep(1.5)
            return c(x, cmd='ui_escape'), log_since(x, mk)
        c(X, cmd='ui_lend', guid=S['h'][0], action='menu'); time.sleep(1)
        c(X, cmd='ui_pop', open=1); time.sleep(1)
