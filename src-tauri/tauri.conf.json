{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS Mod Launcher",
  "version": "0.1.0",
  "identifier": "wiki.dungeonsettlers.modlauncher",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Dungeon Settlers Mod Launcher", "width": 1240, "height": 800, "minWidth": 760, "minHeight": 520, "resizable": true }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
