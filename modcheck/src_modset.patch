 static int last_reject;              /* enum dsnet_reject of the last failed start, 0 if none */
+static int modset_unshown;           /* the last refusal was DSNET_REJ_MODSET and its details were not shown yet */
+/* mpmenu (dlsym), once per DSNET_REJ_MODSET refusal: the notice text naming the missing / extra / other-version gameplay
+ * mods (host lines from the REJECT against this copy's own lines). 1 = out filled, 0 = nothing (new) to show. */
+__attribute__((visibility("default"))) int mp_game_modset_text(char *out, size_t n) {
+    if (!modset_unshown || last_reject != DSNET_REJ_MODSET) return 0;
+    modset_unshown = 0;
+    static char host[DSNET_MODLINES_MAX]; int rule = 0;
+    if (dsnet_reject_host_mods(&rule, host, sizeof host) != 0) host[0] = 0;
+    char body[600];
+    if (!dsmc_guest_text(host, dsnet_my_mod_lines(), rule == 1, NULL, body, sizeof body, NULL))
+        snprintf(body, sizeof body, "%s", dsnet_reject_text(DSNET_REJ_MODSET));   /* same lines, other hash: the host's words */
+    snprintf(out, n, "<size=150%%>Could not join</size>\n%s", body);
+    for (char *q = body; *q; q++) if (*q == '\n') *q = '|';                      /* one log line */
+    rig_log("mp: modset refusal: %s", body);
+    for (char *q = body; *q; q++) if (*q == '|') *q = '\n';
+    return 1;
+}
